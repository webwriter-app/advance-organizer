      "declarations": [
        {
          "kind": "class",
          "description": "A visual advance organizer: a canvas of labeled boxes, connecting arrows and images\nthat gives learners an overview of a topic before they study it in detail.",
          "name": "WebwriterAdvanceOrganizer",
          "cssParts": [
            {
              "description": "The canvas with the nodes, edges and images.",
              "name": "canvas"
            },
            {
              "description": "A page of the advance organizer: the section that holds the page content (printed and shown when opened). Keyboard: with the canvas focused in edit mode, Enter selects the first item (and then edits the label of the selected node or edge), Tab and Shift+Tab step through the items, arrow keys move the selection, C adds a concept, R connects two selected concepts (or starts drawing a relation), I adds an image. Readers reach every node that has a page with Tab and open it with Enter or Space. Conversions: a nested `ul` or `ol` becomes a tree of concepts with arrows from each item to its sub-items (the item text only; lists in an item are its sub-items). The concepts become a nested `ul` again: roots are the concepts without an incoming arrow and sub-items follow the arrows from top to bottom. Edge labels, styles, images and linked pages are not part of the list. Files: `.json` imports and exports the organizer data (nodes, edges, images; linked pages are not included), `image/svg+xml` exports a picture of the canvas (labels as plain text). Signal `openConcept` (string): the label of the concept whose page is open, empty when none is. Theme: text uses `--ww-text-color` and `--ww-font-family`; selection and focus use `--ww-theme-accent-1` (or `--ao-selection-color`). Node and edge colors are authored data and do not follow the theme.",
              "name": "page"
            }
          ],
          "slots": [
            {
              "description": "The pages of the advance organizer, as `<webwriter-advance-organizer-page>` elements.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "dataType",
              "type": {
                "text": "string"
              },
              "static": true,
              "default": "\"application/json\""
            },
            {
              "kind": "field",
              "name": "convertFrom",
              "type": {
                "text": "object"
              },
              "static": true,
              "default": "{ ul: \"loadList\", ol: \"loadList\", \".json\": \"importJson\", }"
            },
            {
