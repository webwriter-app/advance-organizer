  },
  "exports": {
    "./widgets/webwriter-advance-organizer.*": {
      "source": "./src/widgets/webwriter-advance-organizer.ts",
      "default": "./dist/widgets/webwriter-advance-organizer.*"
    },
    "./widgets/webwriter-advance-organizer-page.*": {
      "source": "./src/widgets/webwriter-advance-organizer-page.ts",
      "default": "./dist/widgets/webwriter-advance-organizer-page.*"
    },
    "./snippets/concepts-of-webwriter.html": "./snippets/concepts-of-webwriter.html",
    "./tests/reading.*": {
      "source": "./tests/reading.test.ts",
      "default": "./dist/tests/reading.*"
    },
    "./tests/localization.*": {
      "source": "./tests/localization.test.ts",
      "default": "./dist/tests/localization.*"
    },
    "./tests/editing.*": {
      "source": "./tests/editing.test.ts",
      "default": "./dist/tests/editing.*"
    },
    "./tests/conversion.*": {
      "source": "./tests/conversion.test.ts",
      "default": "./dist/tests/conversion.*"
    },
    "./icon": "./icon.svg",
    "./editing-config.json": "./editing-config.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "editingConfig": {
    "./widgets/webwriter-advance-organizer": {
      "definingAsContext": true,
      "content": "(webwriter-advance-organizer-page)*",
      "importFormats": [
        ".json"
      ],
      "exportFormats": [
        ".json",
        "image/svg+xml"
      ]
    },
    "./widgets/webwriter-advance-organizer-page": {
      "definingForContent": true,
      "content": "(flow)*",
      "uninsertable": true
    }
  },
  "customElements": "custom-elements.json"
}
